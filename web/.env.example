# Frontend (Next.js) environment example
# Copy to `web/.env.local` for local development.

# Public API URL that the frontend will call (backend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# LiveKit URL used by the client for real-time connections
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Optional: Uplift API key (exposed to browser). Use only for local testing.
# WARNING: This will expose the key publicly in client bundles.
NEXT_PUBLIC_UPLIFT_API_KEY=your_uplift_api_key_here
