# Server environment example for LiveKit Voice Agent
# Copy this to `server/.env` and fill in real values.

# LiveKit Configuration
# Get these from https://cloud.livekit.io/
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
LIVEKIT_URL=wss://your-project.livekit.cloud

# OpenAI Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: Override OpenAI API base URL (default is https://api.openai.com/v1)
# Use when pointing to a compatible proxy or different endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
# Uplift AI Configuration (optional)
# Get your API key from https://upliftai.org
# Provides ~300ms first chunk latency for real-time conversations
UPLIFT_API_KEY=your_upliftai_key_here
USE_UPLIFT_TTS=false

# Optional: Override Uplift API base URL
UPLIFT_API_URL=https://api.upliftai.org

# Default Settings
DEFAULT_LANGUAGE=en
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
